{
  "name": "kims-freshdesk-backend",
  "version": "1.0.0",
  "description": "KIMS ICT Service Desk Backend API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "prisma:generate": "prisma generate",
    "prisma:archive:generate": "prisma generate --schema=prisma/archive.prisma",
    "prisma:archive:push": "prisma db push --schema=prisma/archive.prisma",
    "prisma:generate:all": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/archive.prisma",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/archive.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.17.7",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
