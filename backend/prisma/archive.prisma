datasource db {
  provider = "mysql"
  url      = env("ARCHIVE_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-archive"
}

model ArchivedTicket {
  id             BigInt    @id @default(autoincrement())
  ticketId       String    @map("ticket_id") @db.VarChar(50)
  subject        String?   @db.VarChar(500)
  description    String?   @db.MediumText
  status         String?   @db.VarChar(50)
  priority       String?   @db.VarChar(50)
  source         String?   @db.VarChar(50)
  ticketType     String?   @map("ticket_type") @db.VarChar(100)
  agent          String?   @db.VarChar(150)
  group          String?   @db.VarChar(150)
  createdTime    DateTime? @map("created_time")
  resolvedTime   DateTime? @map("resolved_time")
  closedTime     DateTime? @map("closed_time")
  lastUpdateTime DateTime? @map("last_update_time")
  importedAt     DateTime  @default(now()) @map("imported_at")

  @@index([ticketId])
  @@index([status])
  @@index([agent])
  @@index([group])
  @@index([createdTime])
  @@map("archived_tickets")
}
